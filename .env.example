# =============================================================================
# Dungeons and DocumentDB -- environment configuration
# Copy this file to `.env` and fill in your keys.
# =============================================================================

# ---- DocumentDB connection ---------------------------------------------------
# Defaults match docker-compose.yml. Change here if you customised compose.
# OSS DocumentDB requires TLS even locally (self-signed cert).
DOCUMENTDB_HOST=localhost
DOCUMENTDB_PORT=10260
DOCUMENTDB_USERNAME=admin
DOCUMENTDB_PASSWORD=dungeons123!
DOCUMENTDB_DATABASE=dnd

# Override the entire URI if you prefer. Takes precedence over parts above.
# DOCUMENTDB_URI=mongodb://admin:dungeons123!@localhost:10260/?tls=true&tlsAllowInvalidCertificates=true

# ---- LLM provider ------------------------------------------------------------
# Set ONE of these. Anthropic is preferred; OpenAI is the fallback.
# Provider is auto-detected based on which key is present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (sensible defaults are used if blank).
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini

# ---- Embeddings -------------------------------------------------------------
# Voyage AI is recommended with Anthropic. Falls back to OpenAI embeddings if
# VOYAGE_API_KEY is empty but OPENAI_API_KEY is set.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
