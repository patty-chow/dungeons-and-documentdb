# =============================================================================
# Dungeons and DocumentDB -- environment configuration
# Copy this file to `.env` and fill in your keys.
# =============================================================================

# ---- DocumentDB connection ---------------------------------------------------
# Defaults match docker-compose.yml. Change here if you customised compose.
# OSS DocumentDB requires TLS even locally (self-signed cert).
DOCUMENTDB_HOST=localhost
DOCUMENTDB_PORT=10260
DOCUMENTDB_USERNAME=admin
DOCUMENTDB_PASSWORD=dungeons123!
DOCUMENTDB_DATABASE=dnd

# Override the entire URI if you prefer. Takes precedence over parts above.
# DOCUMENTDB_URI=mongodb://admin:dungeons123!@localhost:10260/?tls=true&tlsAllowInvalidCertificates=true

# ---- LLM provider ------------------------------------------------------------
# Set ONE of these. OpenAI is the default because the shipped pre-embedded
# spell data is generated with OpenAI text-embedding-3-small -- using a
# different provider for embeddings would produce vectors of incompatible
# dimensions. Anthropic still works for the chat side; you just need to also
# set OPENAI_API_KEY for the spell book's vector queries.
# Provider is auto-detected based on which key is present.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides (sensible defaults are used if blank).
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Embeddings -------------------------------------------------------------
# OpenAI text-embedding-3-small is the default and matches the shipped
# data/srd_spells_embedded.json file (1536-dim). Voyage AI is an alternative
# but only safe if you also re-embed the spell book with seed_all.py so the
# vector index dimensions match.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite
